# Supabase Integration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


# WhatsApp Verification & Notification Gateway (Z-API, Evolution API or Custom Webhook)
VITE_WHATSAPP_API_ENDPOINT=https://api.z-api.io/instances/YOUR_INSTANCE/token/YOUR_TOKEN/send-text
VITE_WHATSAPP_API_TOKEN=your-whatsapp-token-here

# SMS Verification Gateway (Zenvia, Twilio, Comtele, TotalVoice or Generic REST API)
VITE_SMS_API_ENDPOINT=https://api.zenvia.com/v2/channels/sms/messages
VITE_SMS_API_TOKEN=your-sms-api-token-here

# Verification Gateway Defaults (WHATSAPP | SMS | AUTO)
VITE_PHONE_VERIFY_DEFAULT_CHANNEL=WHATSAPP
VITE_PHONE_VERIFY_GATEWAY_PROVIDER=z-api
